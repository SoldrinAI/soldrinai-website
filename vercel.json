{
  "redirects": [
    { "source": "/smart-search", "destination": "/smart-search/", "permanent": false },
    { "source": "/rag-search", "destination": "/rag-search/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/smart-search/:path*", "destination": "https://soldrin-search.vercel.app/:path*" },
    { "source": "/rag-search/:path*", "destination": "https://soldrinai-rag-chatbot.vercel.app/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
